[Unit]
Description=deploy-hub: delete branches and tags not rooted at the public snapshot (history-sweep)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/deploy-hub/bin/deploy-hub history-sweep
TimeoutStartSec=10min
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/deploy-hub
NoNewPrivileges=yes
