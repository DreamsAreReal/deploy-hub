#!/bin/bash
set +e
set +o pipefail
set -u
BUILD_CACHE_KEEP=${CI_BUILD_CACHE_KEEP:-15gb}
DISK_MAX_PERCENT=${CI_DISK_MAX_PERCENT:-70}
QUOTA_FULL_PERCENT=98

log() {
	echo "ci-runner-clean: $*"
}

wipe() {
	if [[ -n $1 && -d $1 ]]; then
		chmod -R u+w "$1" 2>/dev/null
		find "$1" -mindepth 1 -delete
	fi
}

used_percent() {
	local line
	line=$(df --output=pcent "${HOME}" | tail -1)
	echo "${line//[!0-9]/}"
}

usage() {
	df -B1G --output=used,size "${HOME}" | awk 'NR == 2 {print $1 " of " $2 " GiB"}'
}

containers() {
	docker ps -aq | xargs -r docker rm -f >/dev/null
	docker network prune -f >/dev/null
	docker volume prune -af >/dev/null
	local owner=${GITHUB_REPOSITORY_OWNER:-}
	owner=${owner,,}
	if [[ -n ${owner} ]]; then
		local filter="reference=ghcr.io/${owner}/*"
		docker image ls --filter "${filter}" --format '{{.ID}}' | sort -u | xargs -r docker image rm -f >/dev/null
	fi
	docker image prune -f >/dev/null
	docker builder prune -f --max-used-space "${BUILD_CACHE_KEEP}" >/dev/null
}

/usr/local/lib/ci-runner/ci-runner-reap
before=$(used_percent)
log "disk before: ${before}%"
if [[ ${before} -ge ${QUOTA_FULL_PERCENT} ]]; then
	user=$(id -un)
	total=$(usage)
	echo "::error::ci-runner-clean: the disk quota of ${user} is exhausted (${total}): writes failed with 'Disk quota exceeded'. The cleanup below drops the caches; the quotas live in server/ci-runner/ci-disk-quota of deploy-hub."
fi
containers
wipe "${GITHUB_WORKSPACE:-}"
wipe "${RUNNER_TEMP:-}"
wipe "${TMPDIR:-}"
wipe "${RUNNER_TOOL_CACHE:-}"
[[ -z ${RUNNER_TEMP:-} ]] || wipe "${RUNNER_TEMP%/*}/_actions"

after=$(used_percent)
if [[ ${after} -ge ${DISK_MAX_PERCENT} ]]; then
	log "disk over ${DISK_MAX_PERCENT}%: dropping every image, the build cache and the language caches"
	docker system prune -af --volumes >/dev/null
	for d in .cache go .npm .nuget mutation/work; do
		wipe "${HOME}/${d}"
	done
	after=$(used_percent)
fi
case "${DOCKER_HOST:-}" in
unix://*/docker.sock)
	flag=${DOCKER_HOST#unix://}
	rm -f "${flag%/docker.sock}/job-running"
	;;
esac
total=$(usage)
log "disk after: ${after}% (${total})"
exit 0
