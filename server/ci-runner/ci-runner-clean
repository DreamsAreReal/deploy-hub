#!/bin/bash
set +e
set +o pipefail
set -u
BUILD_CACHE_KEEP=${CI_BUILD_CACHE_KEEP:-15gb}
DISK_MAX_PERCENT=${CI_DISK_MAX_PERCENT:-70}
QUOTA_FULL_PERCENT=98

log() {
  echo "ci-runner-clean: $*"
}

wipe() {
  [ -n "$1" ] && [ -d "$1" ] || return 0
  chmod -R u+w "$1" 2>/dev/null
  find "$1" -mindepth 1 -delete
}

# Under the project quota of the CI user, df of its home reports the quota.
used_percent() {
  df --output=pcent "$HOME" | tail -1 | tr -dc '0-9'
}

usage() {
  df -B1G --output=used,size "$HOME" | awk 'NR == 2 {print $1 " of " $2 " GiB"}'
}

/usr/local/lib/ci-runner/ci-runner-reap
log "disk before: $(used_percent)%"
if [ "$(used_percent)" -ge "$QUOTA_FULL_PERCENT" ]; then
  echo "::error::ci-runner-clean: the disk quota of $(id -un) is exhausted ($(usage)): writes failed with 'Disk quota exceeded'. The cleanup below drops the caches; the quotas live in server/ci-runner/ci-disk-quota of deploy-hub."
fi
docker ps -aq | xargs -r docker rm -f >/dev/null
docker network prune -f >/dev/null
docker volume prune -af >/dev/null
owner=$(printf '%s' "${GITHUB_REPOSITORY_OWNER:-}" | tr '[:upper:]' '[:lower:]')
if [ -n "$owner" ]; then
  docker image ls --filter "reference=ghcr.io/$owner/*" --format '{{.ID}}' | sort -u | xargs -r docker image rm -f >/dev/null
fi
docker image prune -f >/dev/null
docker builder prune -f --max-used-space "$BUILD_CACHE_KEEP" >/dev/null

wipe "${GITHUB_WORKSPACE:-}"
wipe "${RUNNER_TEMP:-}"
wipe "${TMPDIR:-}"
wipe "${RUNNER_TOOL_CACHE:-}"
[ -z "${RUNNER_TEMP:-}" ] || wipe "$(dirname "$RUNNER_TEMP")/_actions"

if [ "$(used_percent)" -ge "$DISK_MAX_PERCENT" ]; then
  log "disk over ${DISK_MAX_PERCENT}%: dropping every image, the build cache and the language caches"
  docker system prune -af --volumes >/dev/null
  for d in .cache go .npm .nuget; do
    wipe "$HOME/$d"
  done
fi
log "disk after: $(used_percent)% ($(usage))"
exit 0
