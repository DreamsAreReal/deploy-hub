#!/bin/sh
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
LIB=/usr/local/lib/ci-runner
UNITS=/etc/systemd/system
WANTS=$UNITS/multi-user.target.wants
OWNER=DreamsAreReal
RUNNER_VERSION=2.338.1
RUNNER_SHA256=08e9ccb3604d2462c24b5e33604dc30810296ca15cc65f23cffd4317eb144c37
CACHE=/var/cache/ci-runner
CI_ROOT=/var/lib/ci
LEGACY_USER=ci
DISK_IMAGE=/srv/ci.img
DISK_SIZE=${CI_DISK_SIZE:-120G}
SUBID_COUNT=65536
QUOTAS=$HERE/ci-disk-quota
DEPLOY_LOCK=/opt/deploy-hub/deploy.lock
HIDDEN="/opt /root /home /etc/srv-backup /etc/wireguard /etc/deploy-hub /var/backups /var/lib/docker /var/lib/containerd -/var/lib/app-backup -/run/docker.sock -/var/run/docker.sock -/run/containerd"

next_subid() {
  awk -F: 'BEGIN {n = 100000} {if ($2 + $3 > n) n = $2 + $3} END {print n}' "$1"
}

check_repo() {
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,28}$' || {
    echo "bad repository name: $1 (lowercase letters, digits, - and _, at most 29)" >&2
    exit 2
  }
}

repo_user() {
  user=ci-$1
  id "$user" >/dev/null 2>&1 ||
    useradd --system --user-group --home-dir "$CI_ROOT/$1" --no-create-home --shell /usr/sbin/nologin "$user"
  if ! grep -q "^$user:" /etc/subuid; then
    start=$(next_subid /etc/subuid)
    usermod --add-subuids "$start-$((start + SUBID_COUNT - 1))" "$user"
  fi
  if ! grep -q "^$user:" /etc/subgid; then
    start=$(next_subid /etc/subgid)
    usermod --add-subgids "$start-$((start + SUBID_COUNT - 1))" "$user"
  fi
}

repo_home() {
  user=ci-$1
  home=$CI_ROOT/$1
  [ -d "$home" ] || install -d -m 700 -o "$user" -g "$user" "$home"
  [ "$(stat -c %U "$home")" = "$user" ] || {
    echo "$home exists but is not owned by $user: remove it first" >&2
    exit 1
  }
  runuser -u "$user" -- mkdir -p -m 700 "$home/runner" "$home/tmp" "$home/docker"
}

jail() {
  repo=$1
  uid=$2
  slice=user-$uid.slice
  install -d -m 755 "$UNITS/$slice.d" "$UNITS/user@$uid.service.d" "$UNITS/ci-docker@$repo.service.d" "$UNITS/ci-runner@$repo.service.d"
  install -m 644 "$HERE/ci-limits.conf" "$UNITS/$slice.d/50-ci-limits.conf"
  cat >"$UNITS/user@$uid.service.d/50-ci-jail.conf" <<UNIT
[Unit]
Requires=ci-netns@$repo.service var-lib-ci.mount
After=ci-netns@$repo.service var-lib-ci.mount

[Service]
Delegate=cpu cpuset io memory pids
NetworkNamespacePath=/run/netns/ci-$repo
BindReadOnlyPaths=/etc/netns/ci-$repo/resolv.conf:/etc/resolv.conf
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=$CI_ROOT/$repo /run/user/$uid
InaccessiblePaths=$HIDDEN
UNIT
  cat >"$UNITS/ci-docker@$repo.service.d/50-ci-user.conf" <<UNIT
[Unit]
Requires=user@$uid.service
After=user@$uid.service

[Service]
Slice=$slice
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus
UNIT
  cat >"$UNITS/ci-runner@$repo.service.d/50-ci-user.conf" <<UNIT
[Service]
Slice=$slice
UNIT
}

in_netns() {
  pid=$(systemctl show -p MainPID --value "$1")
  [ "${pid:-0}" -gt 0 ] || return 0
  [ "$(stat -L -c %i "/proc/$pid/ns/net")" = "$(stat -L -c %i "$2")" ]
}

netns() {
  install -d -m 755 "/etc/netns/ci-$1"
  printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n' >"/etc/netns/ci-$1/resolv.conf"
  systemctl start "ci-netns@$1.service"
}

prepare() {
  repo_user "$1"
  repo_home "$1"
  uid=$(id -u "ci-$1")
  jail "$1" "$uid"
  systemctl daemon-reload
  netns "$1"
  in_netns "user@$uid.service" "/run/netns/ci-$1" || systemctl restart "user@$uid.service"
  loginctl enable-linger "ci-$1"
}

shared_netns() {
  [ -e "$UNITS/ci-netns.service" ] || [ -e /run/netns/ci ] || return 0
  echo "moving the runners from the shared network namespace ci to one per repository" >&2
  out=$(ip -4 route get 1.1.1.1 | grep -o 'dev [^ ]*' | awk '{print $2}')
  systemctl stop 'ci-runner@*.service' 'ci-docker@*.service'
  systemctl disable --now ci-netns.service 2>/dev/null || true
  rm -f "$UNITS/ci-netns.service"
  while iptables -D FORWARD -i ci-host -o "$out" -j ACCEPT 2>/dev/null; do :; done
  while iptables -D FORWARD -o ci-host -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null; do :; done
  while iptables -t nat -D POSTROUTING -s 10.79.0.0/30 -o "$out" -j MASQUERADE 2>/dev/null; do :; done
  ip link del ci-host 2>/dev/null || true
  ip netns del ci 2>/dev/null || true
  rm -rf /etc/netns/ci
}

legacy() {
  id "$LEGACY_USER" >/dev/null 2>&1 || return 0
  uid=$(id -u "$LEGACY_USER")
  mountpoint -q "$CI_ROOT" || {
    echo "$CI_ROOT is not mounted: mount it before removing the user $LEGACY_USER" >&2
    exit 1
  }
  echo "removing the shared runner user $LEGACY_USER: register every repository again" >&2
  for link in "$WANTS"/ci-runner@*.service; do
    [ -L "$link" ] || continue
    systemctl disable --now "$(basename "$link")"
  done
  systemctl stop 'ci-runner@*.service' 'ci-docker@*.service'
  loginctl disable-linger "$LEGACY_USER"
  systemctl stop "user@$uid.service"
  pkill -KILL -U "$uid" || true
  rm -rf "$UNITS/user-$uid.slice.d" "$UNITS/user@$uid.service.d"
  find "$CI_ROOT" -mindepth 1 -maxdepth 1 -user "$LEGACY_USER" -exec rm -rf {} +
  userdel "$LEGACY_USER"
}

disk() {
  if [ ! -f "$DISK_IMAGE" ]; then
    truncate -s "$DISK_SIZE" "$DISK_IMAGE"
    mkfs.ext4 -q -m 0 -L ci -O quota,project -E quotatype=prjquota "$DISK_IMAGE"
  fi
  chmod 600 "$DISK_IMAGE"
  mount_unit
  systemctl daemon-reload
  install -d -m 755 "$CI_ROOT"
  systemctl enable --now var-lib-ci.mount
  chown root:root "$CI_ROOT"
  chmod 755 "$CI_ROOT"
}

# The prjquota mount option fails to mount an image without the project
# feature, so the unit gets it only once quota-enable has run.
mount_unit() {
  if tune2fs -l "$DISK_IMAGE" 2>/dev/null | grep -q '^Filesystem features:.* project'; then
    install -m 644 "$HERE/var-lib-ci.mount" "$UNITS/var-lib-ci.mount"
  else
    sed 's/,prjquota//' "$HERE/var-lib-ci.mount" >"$UNITS/var-lib-ci.mount"
    chmod 644 "$UNITS/var-lib-ci.mount"
  fi
}

quota_gib() {
  awk -v r="$1" '$1 == r && $2 ~ /^[0-9]+$/ {print $2}' "$QUOTAS"
}

quota_enabled() {
  tune2fs -l "$DISK_IMAGE" | grep -q '^Filesystem features:.* project' &&
    findmnt -no OPTIONS "$CI_ROOT" | tr ',' '\n' | grep -qx prjquota
}

# Project quotas need the image unmounted once: only when no job runs.
quota_enable() {
  quota_enabled && return 0
  if pgrep -f 'Runner.Worker' >/dev/null; then
    echo "a CI job is running: enable the quotas when the runners are idle" >&2
    exit 1
  fi
  if [ -e "$DEPLOY_LOCK" ] && ! flock -n "$DEPLOY_LOCK" true; then
    echo "a deploy holds $DEPLOY_LOCK: enable the quotas when it is done" >&2
    exit 1
  fi
  echo "stopping the runners to enable project quotas on $DISK_IMAGE: $(date -u +%FT%TZ)" >&2
  systemctl stop 'ci-runner@*.service' 'ci-docker@*.service'
  for repo in $(registered); do
    systemctl stop "user@$(id -u "ci-$repo").service"
  done
  systemctl stop var-lib-ci.mount
  tune2fs -O quota,project -Q prjquota "$DISK_IMAGE" >/dev/null
  install -m 644 "$HERE/var-lib-ci.mount" "$UNITS/var-lib-ci.mount"
  systemctl daemon-reload
  systemctl start var-lib-ci.mount
  quota_enabled || {
    echo "project quotas are still off on $CI_ROOT" >&2
    exit 1
  }
  for repo in $(registered); do
    repo_quota "$repo"
    systemctl start "user@$(id -u "ci-$repo").service"
  done
  for link in "$WANTS"/ci-runner@*.service; do
    [ -L "$link" ] && systemctl start "$(basename "$link")"
  done
  echo "runners started again: $(date -u +%FT%TZ)" >&2
}

quota_ready() {
  [ -n "$(quota_gib "$1")" ] || {
    echo "no disk quota for $1 in $QUOTAS: add a line '$1 <GiB>' first" >&2
    exit 1
  }
  quota_enabled || {
    echo "project quotas are off on $CI_ROOT: run '$0 quota-enable' while no job runs" >&2
    exit 1
  }
}

repo_quota() {
  quota_ready "$1"
  gib=$(quota_gib "$1")
  uid=$(id -u "ci-$1")
  home=$CI_ROOT/$1
  if [ "$(lsattr -pd "$home" | awk '{print $1}')" != "$uid" ]; then
    find "$home" -xdev -type d -exec chattr +P -p "$uid" {} + &&
      find "$home" -xdev -type f -exec chattr -p "$uid" {} + ||
      echo "warning: some files of $home keep another project and count outside the quota of $1" >&2
  fi
  setquota -P "$uid" 0 $((gib * 1048576)) 0 0 "$CI_ROOT"
}

registered() {
  for runner in "$CI_ROOT"/*/runner/.runner; do
    [ -f "$runner" ] || continue
    repo=${runner%/runner/.runner}
    basename "$repo"
  done
}

host() {
  # quota_v2 (ext4 project quotas) ships in modules-extra, which linux-virtual
  # lacks; the meta package keeps it in step with every new kernel.
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q uidmap slirp4netns nftables quota linux-image-extra-virtual \
    libicu74 libkrb5-3 liblttng-ust1t64 libssl3t64 zlib1g >/dev/null
  install -m 644 "$HERE/rootlesskit.apparmor" /etc/apparmor.d/rootlesskit
  apparmor_parser -r /etc/apparmor.d/rootlesskit
  legacy
  shared_netns
  install -d -m 755 "$LIB"
  install -m 755 "$HERE/ci-netns" "$LIB/ci-netns"
  install -m 755 "$HERE/ci-runner-status" "$LIB/ci-runner-status"
  install -m 755 "$HERE/ci-runner-reap" "$LIB/ci-runner-reap"
  install -m 755 "$HERE/ci-job-started" "$LIB/ci-job-started.sh"
  install -m 755 "$HERE/ci-runner-clean" "$LIB/ci-runner-clean.sh"
  rm -f "$LIB/ci-runner-clean"
  for f in ci-netns@.service ci-docker@.service ci-runner@.service \
    ci-runner-status.service ci-runner-status.timer; do
    install -m 644 "$HERE/$f" "$UNITS/$f"
  done
  rm -f "$UNITS/ci-docker@.service.d/50-ci-user.conf" "$UNITS/ci-runner@.service.d/50-ci-user.conf"
  systemctl daemon-reload
  "$LIB/ci-netns" guard
  disk
  systemctl enable --now ci-runner-status.timer
  for repo in $(registered); do
    prepare "$repo"
    if quota_enabled; then
      repo_quota "$repo"
    else
      echo "warning: no disk quota for $repo until '$0 quota-enable' runs" >&2
    fi
  done
  systemctl try-restart 'ci-docker@*.service' 'ci-runner@*.service'
}

register() {
  repo=$1
  check_repo "$repo"
  read -r token
  quota_ready "$repo"
  user=ci-$repo
  dir=$CI_ROOT/$repo/runner
  tarball=$CACHE/actions-runner-$RUNNER_VERSION.tar.gz
  install -d -m 700 "$CACHE"
  if [ ! -f "$tarball" ]; then
    curl -fsSL -o "$tarball.part" \
      "https://github.com/actions/runner/releases/download/v$RUNNER_VERSION/actions-runner-linux-x64-$RUNNER_VERSION.tar.gz"
    mv "$tarball.part" "$tarball"
  fi
  echo "$RUNNER_SHA256  $tarball" | sha256sum -c --quiet
  prepare "$repo"
  repo_quota "$repo"
  if [ ! -f "$dir/.runner" ]; then
    runuser -u "$user" -- tar -xzf - -C "$dir" <"$tarball"
    ip netns exec "ci-$repo" runuser -u "$user" -- env HOME="$CI_ROOT/$repo" "$dir/config.sh" --unattended \
      --url "https://github.com/$OWNER/$repo" --token "$token" \
      --name "eu-$repo" --labels eu --work _work --replace
  fi
  systemctl enable --now "ci-runner@$repo.service"
}

case "${1:-}" in
  host) host ;;
  register) register "${2:?repository}" ;;
  quota-enable) quota_enable ;;
  *)
    echo "usage: $0 host | quota-enable | register <repo> < registration-token" >&2
    exit 2
    ;;
esac
