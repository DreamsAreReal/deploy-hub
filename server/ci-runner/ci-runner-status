#!/bin/sh
set -eu
URL=${DEPLOY_HUB_METRICS_URL-http://127.0.0.1:8428/api/v1/import/prometheus}
WANTS=/etc/systemd/system/multi-user.target.wants

connected() {
  cg=$(systemctl show -p ControlGroup --value "$1")
  [ -n "$cg" ] || return 1
  pids=$(tr '\n' '|' <"/sys/fs/cgroup$cg/cgroup.procs" 2>/dev/null) || return 1
  [ -n "$pids" ] || return 1
  ip netns exec ci ss -Htnp state established '( dport = :443 )' | grep -Eq "pid=(${pids%|}),"
}

isolated() {
  mountpoint -q /var/lib/ci && [ -e /run/netns/ci ] && nft list table inet ci_netns >/dev/null 2>&1
}

metrics() {
  iso=0
  if isolated; then
    iso=1
  else
    systemctl stop 'ci-runner@*.service'
  fi
  printf 'deploy_hub_ci_isolation_ok %s\n' "$iso"
  for link in "$WANTS"/ci-runner@*.service; do
    [ -e "$link" ] || continue
    unit=$(basename "$link")
    repo=${unit#ci-runner@}
    repo=${repo%.service}
    up=0
    if [ "$iso" = 1 ] && systemctl -q is-active "$unit" && connected "$unit"; then up=1; fi
    printf 'deploy_hub_ci_runner_up{runner="%s"} %s\n' "$repo" "$up"
  done
  if mountpoint -q /var/lib/ci; then
    df -B1 --output=used,size /var/lib/ci | awk 'NR == 2 {printf "deploy_hub_ci_disk_used_ratio %.4f\n", $1 / $2}'
  fi
}

body=$(metrics)
printf '%s\n' "$body"
[ -z "$URL" ] || printf '%s\n' "$body" | curl -fsS --max-time 10 --data-binary @- "$URL"
