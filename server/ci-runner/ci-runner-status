#!/bin/sh
set -u
URL=${DEPLOY_HUB_METRICS_URL-http://127.0.0.1:8428/api/v1/import/prometheus}
DIR=${DEPLOY_HUB_TEXTFILE_DIR-}
SOURCE=ci-runner
WANTS=/etc/systemd/system/multi-user.target.wants
NL=$(printf '\n.')
NL=${NL%.}

connected() {
	cg=$(systemctl show -p ControlGroup --value "ci-runner@$1.service")
	[ -n "${cg}" ] || return 1
	pids=$(tr '\n' '|' 2>/dev/null <"/sys/fs/cgroup${cg}/cgroup.procs") || return 1
	[ -n "${pids}" ] || return 1
	ip netns exec "ci-$1" ss -Htnp state established '( dport = :443 )' | grep -Eq "pid=(${pids%|}),"
}

isolated() {
	mountpoint -q /var/lib/ci && nft list table inet ci_netns >/dev/null 2>&1
}

in_netns() {
	pid=$(systemctl show -p MainPID --value "$1")
	[ "${pid:-0}" -gt 0 ] || return 0
	inner=$(stat -L -c %i "/proc/${pid}/ns/net" 2>/dev/null)
	outer=$(stat -L -c %i "$2" 2>/dev/null)
	[ -n "${inner}" ] && [ "${inner}" = "${outer}" ]
}

netns_ok() {
	uid=$(id -u "ci-$1" 2>/dev/null) || return 1
	/usr/local/lib/ci-runner/ci-netns check "$1" &&
		in_netns "ci-runner@$1.service" "/run/netns/ci-$1" &&
		in_netns "ci-docker@$1.service" "/run/netns/ci-$1" &&
		in_netns "user@${uid}.service" "/run/netns/ci-$1"
}

quota_on() {
	uid=$(id -u "ci-$1" 2>/dev/null) || return 1
	options=$(findmnt -no OPTIONS /var/lib/ci)
	project=$(lsattr -pd "/var/lib/ci/$1" 2>/dev/null | awk '{print $1}')
	printf '%s\n' "${options}" | tr ',' '\n' | grep -qx prjquota && [ "${project}" = "${uid}" ]
}

ratio() {
	usage=$(df -B1 --output=used,size "$1")
	printf '%s\n' "${usage}" | awk -v m="$2" 'NR == 2 {printf "%s %.4f\n", m, $1 / $2}'
}

quota_metrics() {
	on=0
	quota_on "$1" && on=1
	printf 'deploy_hub_ci_quota_on{runner="%s"} %s\n' "$1" "${on}"
	if [ "${on}" = 1 ]; then
		ratio "/var/lib/ci/$1" "deploy_hub_ci_quota_used_ratio{runner=\"$1\"}"
	fi
}

runner_metrics() {
	unit=$1
	repo=${unit#ci-runner@}
	repo=${repo%.service}
	up=0
	broken=0
	if [ "${base}" = 1 ] && ! netns_ok "${repo}"; then
		broken=1
		systemctl stop "${unit}"
	elif [ "${base}" = 1 ] && systemctl -q is-active "${unit}" && connected "${repo}"; then
		up=1
	fi
	printf 'deploy_hub_ci_runner_up{runner="%s"} %s\n' "${repo}" "${up}"
	quota_metrics "${repo}"
	return "${broken}"
}

metrics() {
	base=0
	if isolated; then
		base=1
	else
		systemctl stop 'ci-runner@*.service'
	fi
	iso=${base}
	runners=""
	for link in "${WANTS}"/ci-runner@*.service; do
		[ -e "${link}" ] || continue
		lines=$(runner_metrics "${link##*/}") || iso=0
		runners="${runners}${lines}${NL}"
	done
	printf 'deploy_hub_ci_isolation_ok %s\n%s' "${iso}" "${runners}"
	if mountpoint -q /var/lib/ci; then
		ratio /var/lib/ci deploy_hub_ci_disk_used_ratio
	fi
}

textfile() {
	file="${DIR}/deploy-hub-${SOURCE}.prom"
	now=$(date +%s)
	{
		printf '%s\n' "$1" | sed -e "/{/s/{/{source=\"${SOURCE}\",/" -e "/{/!s/ /{source=\"${SOURCE}\"} /"
		printf 'deploy_hub_textfile_written_timestamp_seconds{source="%s"} %s\n' "${SOURCE}" "${now}"
	} >"${file}.tmp" && mv "${file}.tmp" "${file}"
}

body=$(metrics)
printf '%s\n' "${body}"
[ -z "${DIR}" ] || textfile "${body}"
[ -z "${URL}" ] || printf '%s\n' "${body}" | curl -fsS --max-time 10 --data-binary @- "${URL}"
