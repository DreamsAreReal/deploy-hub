#!/bin/sh
set -u
PATH=/usr/bin:/bin
ROUNDS=50

log() {
  echo "ci-runner-reap: $*" >&2
}

proc_cgroup() {
  sed -n 's/^0:://p' "/proc/$1/cgroup" 2>/dev/null
}

proc_ppid() {
  awk '{sub(/.*\) /, ""); print $2}' "/proc/$1/stat" 2>/dev/null
}

top_of() {
  pid=$1
  cg=$(proc_cgroup "$pid")
  while parent=$(proc_ppid "$pid") && [ -n "$parent" ]; do
    [ "$parent" -gt 1 ] && [ "$(proc_cgroup "$parent")" = "$cg" ] || break
    pid=$parent
  done
  echo "$pid"
}

strays() {
  sed 's|.*|/proc/&/stat|' "/sys/fs/cgroup$1/cgroup.procs" | xargs -r cat 2>/dev/null | awk -v top="$2" '
    {
      pid = $1
      sub(/.*\) /, "")
      parent[pid] = $2
      state[pid] = $1
    }
    END {
      keep[top] = 1
      do {
        grown = 0
        for (p in parent) if (!(p in keep) && (parent[p] in keep)) { keep[p] = 1; grown = 1 }
      } while (grown)
      for (p in parent) if (!(p in keep) && state[p] != "Z") print p, state[p]
    }'
}

cg=$(proc_cgroup $$)
top=$(top_of $$)
if [ -z "$cg" ] || [ ! -r "/sys/fs/cgroup$cg/cgroup.procs" ]; then
  log "no cgroup v2 to reap"
  exit 0
fi
round=0
while [ "$round" -lt "$ROUNDS" ]; do
  list=$(strays "$cg" "$top")
  [ -n "$list" ] || break
  if echo "$list" | awk '$2 != "T" && $2 != "t" {found = 1} END {exit !found}'; then
    echo "$list" | awk '{print $1}' | xargs -r kill -STOP 2>/dev/null
  else
    log "killing $(echo "$list" | wc -l) leftover processes in $cg"
    echo "$list" | awk '{print $1}' | xargs -r kill -KILL 2>/dev/null
  fi
  round=$((round + 1))
done
if [ -n "$(strays "$cg" "$top")" ]; then
  log "processes still left in $cg after $ROUNDS rounds"
  exit 1
fi
exit 0
