#!/bin/sh
set -u
ROUNDS=${CI_REAP_ROUNDS:-20}

log() {
  echo "ci-runner-reap: $*" >&2
}

proc_cgroup() {
  sed -n 's/^0:://p' "/proc/$1/cgroup" 2>/dev/null
}

proc_ppid() {
  awk '{sub(/.*\) /, ""); print $2}' "/proc/$1/stat" 2>/dev/null
}

top_of() {
  pid=$1
  cg=$(proc_cgroup "$pid")
  while parent=$(proc_ppid "$pid") && [ -n "$parent" ]; do
    [ "$parent" -gt 1 ] && [ "$(proc_cgroup "$parent")" = "$cg" ] || break
    pid=$parent
  done
  echo "$pid"
}

strays() {
  while read -r pid; do
    ppid=$(proc_ppid "$pid") && [ -n "$ppid" ] && printf '%s %s\n' "$pid" "$ppid"
  done <"/sys/fs/cgroup$1/cgroup.procs" | awk -v top="$2" '
    { parent[$1] = $2 }
    END {
      keep[top] = 1
      do {
        grown = 0
        for (p in parent) if (!(p in keep) && (parent[p] in keep)) { keep[p] = 1; grown = 1 }
      } while (grown)
      for (p in parent) if (!(p in keep)) print p
    }'
}

cg=$(proc_cgroup $$)
top=$(top_of $$)
if [ -z "$cg" ] || [ ! -r "/sys/fs/cgroup$cg/cgroup.procs" ]; then
  log "no cgroup v2 to reap"
  exit 0
fi
killed=0
round=0
while [ "$round" -lt "$ROUNDS" ]; do
  pids=$(strays "$cg" "$top")
  [ -n "$pids" ] || break
  echo "$pids" | xargs -r kill -KILL 2>/dev/null
  killed=$((killed + $(echo "$pids" | wc -l)))
  round=$((round + 1))
done
[ "$killed" -eq 0 ] || log "killed $killed leftover processes in $cg"
[ -z "$(strays "$cg" "$top")" ] || log "processes still left in $cg after $ROUNDS rounds"
exit 0
