#!/bin/sh
set +e
case "${GITHUB_EVENT_NAME:-}" in
  push | workflow_dispatch | schedule) ;;
  *)
    echo "ci-job-started: this runner takes no ${GITHUB_EVENT_NAME:-unknown} events"
    exit 1
    ;;
esac
if [ "${GITHUB_REF:-}" != refs/heads/main ]; then
  echo "ci-job-started: this runner takes only refs/heads/main, got ${GITHUB_REF:-?}"
  exit 1
fi
case "${GITHUB_WORKFLOW_REF:-}" in
  "${GITHUB_REPOSITORY:-?}/.github/workflows/"*"@refs/heads/main") ;;
  *)
    echo "ci-job-started: workflow ${GITHUB_WORKFLOW_REF:-?} is not from main of ${GITHUB_REPOSITORY:-?}"
    exit 1
    ;;
esac
exit 0
