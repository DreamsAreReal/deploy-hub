#!/bin/sh
set +e
/usr/local/lib/ci-runner/ci-runner-reap || {
  echo "ci-job-started: a process of an earlier job survived, refusing the job"
  exit 1
}
case "${GITHUB_EVENT_NAME:-}" in
  push | workflow_dispatch | schedule) ;;
  *)
    echo "ci-job-started: this runner takes no ${GITHUB_EVENT_NAME:-unknown} events"
    exit 1
    ;;
esac
if [ "${GITHUB_REF:-}" != refs/heads/main ]; then
  echo "ci-job-started: this runner takes only refs/heads/main, got ${GITHUB_REF:-?}"
  exit 1
fi
case "${GITHUB_WORKFLOW_REF:-}" in
  "${GITHUB_REPOSITORY:-?}/.github/workflows/"*"@refs/heads/main") ;;
  *)
    echo "ci-job-started: workflow ${GITHUB_WORKFLOW_REF:-?} is not from main of ${GITHUB_REPOSITORY:-?}"
    exit 1
    ;;
esac
quota=$(df -B1G --output=used,size,pcent "${HOME:-/nonexistent}" 2>/dev/null | awk 'NR == 2 {print $1 " of " $2 " GiB (" $3 ")"}')
echo "ci-job-started: disk quota of $(id -un): ${quota:-unknown}"
case "$quota" in
  *"(9"[5-9]"%)" | *"(100%)")
    echo "ci-job-started: the disk quota of $(id -un) is full even after the last cleanup, refusing the job; free $HOME or raise its line in server/ci-runner/disk-quota of deploy-hub"
    exit 1
    ;;
esac
exit 0
